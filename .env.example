# BUHA - Beispielkonfiguration
# Diese Datei enthaelt keine echten Zugangsdaten.

APP_NAME=BUHA
APP_ENV=production
APP_DOMAIN=localhost
APP_URL=http://localhost:8000

# PostgreSQL
POSTGRES_DB=buha
POSTGRES_USER=buha
POSTGRES_PASSWORD=CHANGE_ME

# Datenbankverbindung
DATABASE_URL=postgresql+psycopg://buha:CHANGE_ME@db:5432/buha

# Anwendungssicherheit
SECRET_KEY=CHANGE_ME
SESSION_COOKIE_SECURE=false

# E-Mail-Versand
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Rechnungsstellung
DEFAULT_CURRENCY=EUR
DEFAULT_LANGUAGE=de
DEFAULT_VAT_RATE=19

# Zeitzone
TZ=Europe/Berlin

# Erster Administrator der BUHA-Weboberflaeche
# Nur bei der erstmaligen Initialisierung verwenden.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
